{
  "profiles": {
    "kubernetes": {
      "fn-k8s-kubernetes": {
        "environment": "fn-k8s",
        "kubeconfig": "kubeconfig",
        "context": "develop-reader",
        "timeout": 20,
        "permissions": {"read": true},
        "allow_after_approval": ["create", "update", "delete"],
        "scope": {"namespaces": ["develop"], "resources": ["pods", "services", "deployments", "daemonsets", "events"]}
      }
    }
  }
}
